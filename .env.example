# Маяк · переменные окружения. Скопируйте в .env и заполните. Не коммитьте .env.
# Подключение Supabase по шагам — docs/supabase-setup.md.

# ── Сервер API ──────────────────────────────────────────────────────────────
# supabase — проверка токенов Supabase Auth (production); dev — вход разработчика.
MAYAK_AUTH=supabase
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase: transaction pooler (6543) для API, session pooler/direct для миграций.
DATABASE_URL=postgres://mayak:mayak@localhost:5432/mayak_dev
MIGRATION_DATABASE_URL=
# Корневой сертификат Supabase (Database Settings → SSL), PEM; \n допускаются.
DATABASE_CA_CERT=
# 1 — для serverless-функций, 5–10 — для долгоживущего сервера.
DATABASE_POOL_MAX=10

# ТОЛЬКО для локальной разработки: вход «Authorization: Bearer dev:<имя>» без проверки личности.
# Используется при MAYAK_AUTH=dev. В production запрещено (NODE_ENV=production).
MAYAK_DEV_AUTH=
PORT=8787

# Тестовые базы: имя обязано содержать «test», тесты пересоздают схемы.
TEST_DATABASE_URL=postgres://mayak:mayak@localhost:5432/mayak_test
MAYAK_E2E_DATABASE_URL=postgres://mayak:mayak@localhost:5432/mayak_e2e_test

# ── Веб-клиент (попадает в сборку — только публичные значения) ─────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# По умолчанию /api/v1 того же сайта.
VITE_API_BASE=
# 1 — показать «Режим разработчика» в настройках (не для production-сборки).
VITE_DEV_SYNC=

# ── Ещё не используется ──
# BLOB_READ_WRITE_TOKEN=   # только на сервере, никогда в клиенте
