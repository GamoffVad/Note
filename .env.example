# Маяк · переменные окружения. Скопируйте в .env и заполните. Не коммитьте .env.

# PostgreSQL для локальной разработки (npm run db:migrate, npm run dev:api).
DATABASE_URL=postgres://mayak:mayak@localhost:5432/mayak_dev

# Отдельная тестовая база. Имя обязано содержать «test»: тесты пересоздают схему public.
TEST_DATABASE_URL=postgres://mayak:mayak@localhost:5432/mayak_test

# ТОЛЬКО для локальной разработки: вход по заголовку «Authorization: Bearer dev:<имя>» без проверки личности.
# В production запрещено (NODE_ENV=production).
MAYAK_DEV_AUTH=1
PORT=8787

# ── Ещё не используется: появится вместе с адаптерами провайдеров ──
# SUPABASE_URL=
# SUPABASE_JWT_ISSUER=
# BLOB_READ_WRITE_TOKEN=   # только на сервере, никогда в клиенте
