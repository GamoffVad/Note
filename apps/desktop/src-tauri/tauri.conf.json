{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mayak",
  "version": "0.1.0",
  "identifier": "io.github.gamoffvad.mayak",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:desktop",
      "cwd": "../../web"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build:desktop",
      "cwd": "../../web"
    },
    "frontendDist": "../../web/dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Маяк",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Заметки, задачи и файлы на всех устройствах",
    "longDescription": "Маяк — заметки, задачи и передача файлов между Windows, macOS, Linux, Android и iOS. Работает без интернета и синхронизируется, когда сеть появляется.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "io.github.gamoffvad.mayak"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "io.github.gamoffvad.mayak"
          ],
          "appLink": false
        }
      ]
    }
  }
}
